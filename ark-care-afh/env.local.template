# Ark Care AFH - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to git

# ============================================
# REQUIRED FOR PRODUCTION
# ============================================

# SendGrid API Key (Get from https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=

# Contact Email (Where form submissions are sent)
CONTACT_EMAIL=

# From Email (Must be verified in SendGrid)
FROM_EMAIL=

# ============================================
# OPTIONAL - RATE LIMITING (Production)
# ============================================

# Upstash Redis URL (Get from https://console.upstash.com/)
UPSTASH_REDIS_REST_URL=

# Upstash Redis Token
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# OPTIONAL - ERROR TRACKING (Recommended)
# ============================================

# Sentry DSN (Get from https://sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Organization
SENTRY_ORG=

# Sentry Project
SENTRY_PROJECT=

# Sentry Auth Token (For source maps)
SENTRY_AUTH_TOKEN=

# ============================================
# OPTIONAL - ANALYTICS
# ============================================

# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=

# ============================================
# SITE CONFIGURATION
# ============================================

# Site URL (Development: http://localhost:3000, Production: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

